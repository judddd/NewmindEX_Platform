# ==================== 版本配置 ====================
# Docker 镜像版本号，方便统一升级
ES_VERSION=8.17.3
KIBANA_VERSION=8.17.3
LOGSTASH_VERSION=8.17.3
NEWFLOW_VERSION=1.0.4
NEWCHAT_DOCS_VERSION=1.0.1

# ==================== Elasticsearch 配置 ====================
# 集群名称
ES_CLUSTER_NAME=es-cluster

# 内存配置 (重要：根据服务器配置调整)
# 生产环境推荐: 31g (64GB RAM 机器)
# 开发/测试环境: 2g 或 4g
ES_MEM=31g

# 端口配置
ES_PORT_1=9200                # ES 主节点端口
ES_PORT_2=9201                # ES 从节点1 端口
ES_PORT_3=9202                # ES 从节点2 端口

# 安全配置
ES_SECURITY_ENABLED=false     # 是否启用安全认证 (true/false)
ES_ML_ENABLED=true            # 是否启用 ML 功能 (true/false)

# ES 认证密码 (仅在 ES_SECURITY_ENABLED=true 时使用)
# 注意：启用安全后需要重新初始化集群
ELASTIC_PASSWORD=changeme123

# ==================== Kibana 配置 ====================
KIBANA_PORT=5601

# ==================== Logstash 配置 ====================
LOGSTASH_PORT=5044            # Logstash 数据接收端口
LOGSTASH_API_PORT=9600        # Logstash API/监控端口

# ==================== NewFlow 配置 ====================
# 基础配置
NEWFLOW_PORT=5678
NEWFLOW_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIyYTgzN2Q0NC05YjhhLTRkNjItYjBjYS03OWU4YWY4YjRmMGEiLCJpc3MiOiJuOG4iLCJhdWQiOiJwdWJsaWMtYXBpIiwiaWF0IjoxNzYzMzcxOTg2fQ.SWeigVxsr-vFDJNiQ-wIInBUT6D75ZpbMBgHQDxzjzU
NEWFLOW_DOCS_PORT=8001

# 自动初始化配置
NEWFLOW_AUTO_SETUP_ENABLED=true
NEWFLOW_AUTO_SETUP_EMAIL=admin@localhost.com
NEWFLOW_AUTO_SETUP_PASSWORD=admin123A
NEWFLOW_PREDEFINED_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIyYTgzN2Q0NC05YjhhLTRkNjItYjBjYS03OWU4YWY4YjRmMGEiLCJpc3MiOiJuOG4iLCJhdWQiOiJwdWJsaWMtYXBpIiwiaWF0IjoxNzYzMzcxOTg2fQ.SWeigVxsr-vFDJNiQ-wIInBUT6D75ZpbMBgHQDxzjzU

# AI 集成配置
NEWFLOW_CUSTOM_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEWFLOW_CUSTOM_AI_API_KEY=sk-ead41741d55b40388d590690d3163a2b
NEWFLOW_CUSTOM_AI_MODEL=qwen-plus

# 高级配置 (通常使用默认值即可)
NEWFLOW_LISTEN_ADDRESS=0.0.0.0
DB_SQLITE_POOL_SIZE=5
NEWFLOW_RUNNERS_ENABLED=true
NEWFLOW_BLOCK_ENV_ACCESS_IN_NODE=false
NEWFLOW_GIT_NODE_DISABLE_BARE_REPOS=true
NEWFLOW_SECURE_COOKIE=false

# ==================== NewChat 配置 ====================
NEWCHAT_DOCS_PORT=8002

# ==================== LM Studio 配置 ====================
LMSTUDIO_PORT=1234
LM_MODEL=qwen/qwen3-coder-30b
LM_VARIANT=mlx

# ==================== Dashboard 配置 ====================
DASHBOARD_PORT=8000

# ==================== 下载配置 (可选) ====================
# 留空则使用 config.yaml 中的默认下载源
# 如需自定义下载地址，请填写完整 URL
LMSTUDIO_DMG_URL=
NEWFLOW_TAR_URL=
NEWCHAT_DMG_URL=


# ==================== MinIO 配置 ====================
# MinIO 端口配置
MINIO_API_PORT=9000              # MinIO API 端口
MINIO_CONSOLE_PORT=9001          # MinIO Web 控制台端口

# MinIO 认证配置
MINIO_ROOT_USER=minioadmin       # MinIO 管理员用户名
MINIO_ROOT_PASSWORD=minioadmin123 # MinIO 管理员密码 (建议修改)

# MinIO 数据目录
MINIO_DATA_DIR=./minio_data      # MinIO 数据存储目录

# MinIO 版本
MINIO_VERSION=latest