# CMDB MCP Server Configuration
# Copy this file to .env and update with your credentials

# Required: CMDB API Settings
CMDB_DOMAIN=https://cmdb-service.starbucks.net
CMDB_APP_ID=your-app-id-here
CMDB_APP_SECRET=your-app-secret-here

# Optional: SSL Certificate Verification
# Set to "0" to disable (default), "1" to enable
CMDB_VERIFY_SSL=0

# Optional: Custom CA Certificate Path
# Uncomment and set path if using self-signed or internal CA
# CMDB_CA_CERT_PATH=/path/to/company-ca.pem

# Optional: HTTP Transport Settings (for streamable mode)
# Leave MCP_TRANSPORT unset for stdio mode (default)
MCP_TRANSPORT=http
MCP_HTTP_HOST=localhost
MCP_HTTP_PORT=3000

