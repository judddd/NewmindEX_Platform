{
  "name": "@your-org/mcp-server-cmdb",
  "description": "MCP Server for CMDB API integration with full query support",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "bin": {
    "mcp-server-cmdb": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/mcp-server-cmdb.git"
  },
  "keywords": [
    "cmdb",
    "mcp",
    "mcp-server",
    "asset-management"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@types/express": "^5.0.3",
    "axios": "^1.7.0",
    "express": "^5.1.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.15",
    "shx": "^0.4.0",
    "typescript": "^5.8.2"
  }
}

